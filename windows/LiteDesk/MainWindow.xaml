<Window x:Class="LiteDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LiteDesk.Views"
        xmlns:loc="clr-namespace:LiteDesk.Localization"
        Title="LiteDesk" Height="700" Width="1000" MinHeight="500" MinWidth="700"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <ContentControl x:Name="ContentHost"/>

        <!--
            Incoming-connection approval prompt. Lives here (not on HomeView)
            because Server — like the connection request it's answering —
            outlives HomeView across navigation to an active outgoing
            session; the host must still be able to answer it either way.
            See MainWindow.xaml.cs.
        -->
        <Grid x:Name="ConnectionRequestOverlay" Background="#59000000" Visibility="Collapsed">
            <views:BlueprintPanel Width="340" Padding="20" Background="{StaticResource BgBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ConnectionRequest.Title]}"
                               FontFamily="{StaticResource HeadingFont}" FontSize="17"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ConnectionRequest.Message]}"
                               FontSize="13" Foreground="{StaticResource SubtitleBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ConnectionRequest.From]}"
                                   FontSize="11" Foreground="{StaticResource SubtitleBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ConnectionRequestAddressText" FontFamily="Consolas" FontSize="12.5"
                                   Foreground="{StaticResource TextBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="DeclineConnectionButton" Style="{StaticResource SecondaryButton}"
                                Click="DeclineConnectionButton_Click"
                                Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ConnectionRequest.Decline]}"/>
                        <Button x:Name="ApproveConnectionButton" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                Click="ApproveConnectionButton_Click"
                                Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ConnectionRequest.Approve]}"/>
                    </StackPanel>
                </StackPanel>
            </views:BlueprintPanel>
        </Grid>
    </Grid>
</Window>
