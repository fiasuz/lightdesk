<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>LiteDesk</RootNamespace>
    <AssemblyName>LiteDesk</AssemblyName>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\LiteDesk.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!--
      Publish settings so `dotnet publish -c Release` alone produces the
      self-contained single-exe output the plan calls for (no runtime
      install needed on the target machine), without extra command-line
      flags. RuntimeIdentifier pins win-x64 (the only target per the plan).
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <!--
    Bundled cloudflared: lets a host expose itself over the public internet
    (Cloudflare quick tunnel) with no router/port-forwarding and no relay
    server of our own — see Services/CloudflareTunnelService.cs. The binary
    isn't committed to git (keeps the repo binary-free); this target fetches
    it once per machine into Tools/, which is gitignored.
  -->
  <Target Name="EnsureCloudflared" BeforeTargets="Build;Publish">
    <MakeDir Directories="Tools" Condition="!Exists('Tools')"/>
    <Exec Command="curl.exe -L -o Tools\cloudflared.exe https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-windows-amd64.exe"
          Condition="!Exists('Tools\cloudflared.exe')"/>
  </Target>

  <!--
    Copies the already-downloaded cloudflared.exe next to the build/publish
    output via an explicit Copy task (rather than a None/CopyToOutputDirectory
    item): that item-based pipeline runs its own AssignTargetPaths/
    GetCopyToOutputDirectoryItems steps earlier in the Build dependency chain
    than a BeforeTargets="Build" hook can reliably beat, so an item added
    dynamically there was silently never copied. AfterTargets guarantees
    $(TargetDir)/$(PublishDir) are both fully resolved (RID subfolder from
    RuntimeIdentifier above included) by the time we copy into them.
  -->
  <Target Name="CopyCloudflaredToOutput" AfterTargets="Build" Condition="Exists('Tools\cloudflared.exe')">
    <Copy SourceFiles="Tools\cloudflared.exe" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyCloudflaredToPublish" AfterTargets="Publish" Condition="Exists('Tools\cloudflared.exe')">
    <Copy SourceFiles="Tools\cloudflared.exe" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
