<UserControl x:Class="LiteDesk.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LiteDesk.Views"
             xmlns:loc="clr-namespace:LiteDesk.Localization">
    <!--
        Unified "01 Ulanish" screen: language switch + "my address" (host
        role, always listening) + "connect to other" (viewer role) shown
        together, plus a permissions panel below — no more mode-select step.
        See HomeView.xaml.cs.
    -->
    <Grid Background="{StaticResource BgBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40">
            <StackPanel MaxWidth="900" HorizontalAlignment="Center">

                <!-- Header + language switch -->
                <Grid Margin="0,0,0,28">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="LITEDESK" FontFamily="{StaticResource HeadingFont}" FontSize="34"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Home.Subtitle]}"
                                   Style="{StaticResource KickerText}" Margin="16,0,0,4" VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <ComboBox x:Name="LanguageCombo" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="150"
                              SelectionChanged="LanguageCombo_SelectionChanged">
                        <ComboBoxItem Content="O'zbekcha"/>
                        <ComboBoxItem Content="Русский"/>
                        <ComboBoxItem Content="English"/>
                    </ComboBox>
                </Grid>
                <Border Style="{StaticResource Divider}" Margin="0,0,0,32"/>

                <!-- 1/2: my address + connect to other, side by side -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1: my address -->
                    <views:BlueprintPanel x:Name="MyAddressPanel" Grid.Column="0" Padding="22" Background="{StaticResource BgBrush}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource StepBadge}">
                                    <TextBlock Text="1" Style="{StaticResource StepBadgeText}"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0">
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Home.MyAddress.Title]}"
                                               FontFamily="{StaticResource HeadingFont}" FontSize="18"
                                               Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Home.MyAddress.Subtitle]}"
                                               FontSize="12" Foreground="{StaticResource SubtitleBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>

                            <views:BlueprintPanel x:Name="MyAddressValuePanel" Padding="16" Background="{StaticResource SurfaceBrush}" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Home.MyAddress.Label]}"
                                               Style="{StaticResource CardLabel}"/>
                                    <TextBlock x:Name="MyAddressText" FontFamily="{StaticResource HeadingFont}" FontSize="18"
                                               Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button x:Name="CopyButton" Style="{StaticResource SecondaryButton}" Click="CopyButton_Click"
                                                IsEnabled="False"
                                                Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Home.MyAddress.Copy]}"/>
                                        <Button x:Name="ShareButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ShareButton_Click"
                                                IsEnabled="False"
                                                Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Home.MyAddress.Share]}"/>
                                        <Button x:Name="NewAddressButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="NewAddressButton_Click"
                                                Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Home.MyAddress.NewAddress]}"/>
                                    </StackPanel>
                                </StackPanel>
                            </views:BlueprintPanel>

                            <StackPanel Margin="0,14,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="HostStatusDot" Width="8" Height="8" Fill="{StaticResource SubtitleBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="HostStatusText" FontSize="13" Margin="8,0,0,0"
                                               Foreground="{StaticResource SubtitleBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel x:Name="HostStatsPanel" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Common.Ping]}"
                                               FontSize="11" Foreground="{StaticResource SubtitleBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="HostPingText" Text="—" FontFamily="{StaticResource HeadingFont}"
                                               FontSize="13" Margin="6,0,16,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Common.Fps]}"
                                               FontSize="11" Foreground="{StaticResource SubtitleBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="HostFpsText" Text="—" FontFamily="{StaticResource HeadingFont}"
                                               FontSize="13" Margin="6,0,16,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Common.Time]}"
                                               FontSize="11" Foreground="{StaticResource SubtitleBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="HostElapsedText" Text="00:00:00" FontFamily="{StaticResource HeadingFont}"
                                               FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </views:BlueprintPanel>

                    <!-- 2: connect to other -->
                    <views:BlueprintPanel Grid.Column="2" Padding="22" Background="{StaticResource BgBrush}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource StepBadge}">
                                    <TextBlock Text="2" Style="{StaticResource StepBadgeText}"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0">
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Home.Connect.Title]}"
                                               FontFamily="{StaticResource HeadingFont}" FontSize="18"
                                               Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Home.Connect.Subtitle]}"
                                               FontSize="12" Foreground="{StaticResource SubtitleBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Home.Connect.Label]}"
                                       Style="{StaticResource CardLabel}" Margin="0,18,0,4"/>
                            <TextBox x:Name="ConnectAddressBox" FontFamily="{StaticResource HeadingFont}" FontSize="16"/>

                            <Button x:Name="ConnectButton" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" Click="ConnectButton_Click"
                                    Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Home.Connect.Button]}"/>
                            <TextBlock x:Name="ConnectStatusText" Margin="0,12,0,0" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{StaticResource SubtitleBrush}"/>
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Home.Connect.Disclaimer]}"
                                       FontSize="12" Foreground="{StaticResource FaintTextBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </views:BlueprintPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
