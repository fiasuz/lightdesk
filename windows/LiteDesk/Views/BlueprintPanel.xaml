<UserControl x:Class="LiteDesk.Views.BlueprintPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!--
        The "blueprint" motif from the industry design system: a hairline
        border plus four small L-shaped registration marks sitting just
        outside each corner. ClipToBounds="False" lets those marks render
        past the border's own edge.

        Content is exposed as PanelContent (not the inherited Content),
        because Content already resolves to this Grid — see
        BlueprintPanel.xaml.cs's [ContentProperty] attribute, which is what
        lets a caller still write <views:BlueprintPanel>...</views:BlueprintPanel>
        and have the nested XML set PanelContent instead.
    -->
    <Grid ClipToBounds="False">
        <Border Background="{Binding Background, ElementName=Root}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="1"
                Padding="{Binding Padding, ElementName=Root}">
            <ContentPresenter Content="{Binding PanelContent, ElementName=Root}"/>
        </Border>

        <Path Data="M0,11 L0,0 L11,0" Stroke="{StaticResource CornerBrush}" StrokeThickness="1"
              HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-6,-6,0,0"/>
        <Path Data="M0,0 L11,0 L11,11" Stroke="{StaticResource CornerBrush}" StrokeThickness="1"
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0"/>
        <Path Data="M0,0 L0,11 L11,11" Stroke="{StaticResource CornerBrush}" StrokeThickness="1"
              HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-6,0,0,-6"/>
        <Path Data="M0,11 L11,11 L11,0" Stroke="{StaticResource CornerBrush}" StrokeThickness="1"
              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-6"/>
    </Grid>
</UserControl>
